cabal-version:      3.12
name:               pre-rich-plutus
version:            0.1.0.0
build-type:         Simple

library
    hs-source-dirs:
        .
        ../IMMORTAL/state
        ../IMMORTAL/kernel
        ../IMMORTAL/conformance
        ../Adapter/CARDANO/observation
        ../IMMORTAL/governance
        ../PRE-RICH/profile

    exposed-modules:
        Types
        OracleTypes
        Beacon
        GameRules
        BeaconRegistry
        Economic
        B1PrizePool
        CounterValidator
        MintPolicy
        PrizeValidator
        Treasury
        EconomicProfile
        EconomicStateV3
        UniversalEconomicState
        EconomicGate
        EconomicKernel
        UniversalEconomicKernel
        EconomicTransitionV3
        RefinementV3
        GoldenVectors
        PreRichEconomicProfile
        PreRichEconomicProjection
        PreRichEconomicAdmission
        B1LegacyAdapter
        ProtectedCapitalConformance
        Governance
        GovernanceEventSchema
        GovernanceAuthorization
        GovernanceCanonicalReplay
        GovernanceCanonicalSerialization
        GovernanceCommitment
        RulesetRegistry
        GovernanceRuleset
        GovernanceFinality

    other-modules:

    build-depends:
        base ^>=4.18.2,
        plutus-core ^>=1.67.0.0,
        plutus-ledger-api ^>=1.67.0.0,
        plutus-tx ^>=1.67.0.0,
        plutus-tx-plugin ^>=1.67.0.0,
        bytestring,
        base16-bytestring,
        text,
        cryptohash-sha256

    default-language: Haskell2010

    ghc-options:
        -Wall
        -fno-strictness
        -fno-specialise
        -fno-spec-constr
        -fno-unbox-strict-fields
        -fno-unbox-small-strict-fields

executable export-scripts
    hs-source-dirs:
        export
    main-is: Export.hs
    build-depends:
        base ^>=4.18.2,
        plutus-core ^>=1.67.0.0,
        plutus-ledger-api ^>=1.67.0.0,
        plutus-tx ^>=1.67.0.0,
        plutus-tx-plugin ^>=1.67.0.0,
        aeson,
        base16-bytestring,
        bytestring,
        directory,
        text,
        pre-rich-plutus
    default-language: Haskell2010
    ghc-options:
        -Wall
        -fno-strictness
        -fno-specialise
        -fno-spec-constr
        -fno-unbox-strict-fields
        -fno-unbox-small-strict-fields

test-suite economic-oracle-tests
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: EconomicOracleTest.hs
    build-depends:
        base ^>=4.18.2,
        bytestring,
        plutus-core ^>=1.67.0.0,
        plutus-ledger-api ^>=1.67.0.0,
        plutus-tx ^>=1.67.0.0,
        pre-rich-plutus
    default-language: Haskell2010

