{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LiberoNuvola/Immortal-Protocol/blob/work/immortal-green-closure/audit/jev/verification-registry.schema.json",
  "title": "IMMORTAL JEV Verification Registry",
  "description": "Evidence-backed verification results. This registry records observations; it does not define protocol economics or authorize deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registryVersion",
    "generatedAt",
    "subject",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "immortal.jev-verification-registry.v1"
    },
    "registryVersion": {
      "const": "0.1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commitSha",
        "ref",
        "executionContext"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "workflowRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflowRunUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "runAttempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "executionContext": {
          "enum": [
            "unit-test",
            "static-analysis",
            "emulator",
            "devnet",
            "preprod",
            "mainnet"
          ]
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkId",
          "requirementRef",
          "result",
          "evidenceRefs",
          "limitations"
        ],
        "properties": {
          "checkId": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._:-]{1,127}$"
          },
          "requirementRef": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "uri"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "workflow-run",
                    "log",
                    "artifact",
                    "commit",
                    "onchain-observation",
                    "metric",
                    "test-report",
                    "other"
                  ]
                },
                "uri": {
                  "type": "string",
                  "format": "uri"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^(sha256:)?[0-9a-f]{64}$"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observedValue": {},
          "expectedValue": {},
          "relatedCheckIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "overallResult": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
