@@ -0,0 +1,70 @@
+"""Regression tests for fail-closed Receipt verification decisions."""
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "tools" / "materios-verify"))
+
+from materios_verify.core import (
+    StepResult,
+    VerificationReport,
+    VerificationResult,
+    _classify_report_result,
+    _mark_required_evidence_missing,
+)
+
+
+class FailClosedVerificationTests(unittest.TestCase):
+    def make_report(self):
+        report = VerificationReport(receipt_id="0x" + "11" * 32, rpc_url="mock://")
+        report.cert_hash = "0x" + "22" * 32
+        report.steps = [StepResult(step=i, title=f"step-{i}", passed=True) for i in range(8)]
+        return report
+
+    def test_missing_manifest_never_passes(self):
+        step = StepResult(step=6, title="Verify manifest hash", passed=True)
+        _mark_required_evidence_missing(step, "manifest unavailable")
+        self.assertFalse(step.passed)
+        self.assertEqual(step.details["status"], "MISSING")
+
+    def test_missing_availability_event_never_passes(self):
+        step = StepResult(step=7, title="Locate AvailabilityCertified event", passed=True)
+        _mark_required_evidence_missing(step, "event unavailable")
+        self.assertFalse(step.passed)
+        self.assertEqual(step.details["status"], "MISSING")
+
+    def test_steps_passing_without_grandpa_authority_and_cardano_proofs_is_partial(self):
+        report = self.make_report()
+        self.assertEqual(
+            _classify_report_result(report, checkpoint_found=True),
+            VerificationResult.PARTIALLY_VERIFIED,
+        )
+
+    def test_full_result_requires_every_independent_proof_flag(self):
+        report = self.make_report()
+        report.grandpa_finality_verified = True
+        report.authority_set_provenance_verified = True
+        report.cardano_l1_anchor_verified = True
+        self.assertEqual(
+            _classify_report_result(report, checkpoint_found=True),
+            VerificationResult.FULLY_VERIFIED,
+        )
+
+    def test_any_failed_step_blocks_full_result(self):
+        report = self.make_report()
+        report.grandpa_finality_verified = True
+        report.authority_set_provenance_verified = True
+        report.cardano_l1_anchor_verified = True
+        report.steps[6].passed = False
+        self.assertEqual(
+            _classify_report_result(report, checkpoint_found=True),
+            VerificationResult.PARTIALLY_VERIFIED,
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
