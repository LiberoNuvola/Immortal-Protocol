/// The historical accounting predicate accepts the exact one-third point,
/// while 3333 basis points is strictly below one third. This is intentional:
/// production applies the configured integer bps exactly, without an implicit
/// exception for the genesis value.
test sv_underwrite_governed_parameter_exact_one_third_boundary() {
  let old = sv_state(1000, 0, 10_000_000)
  let new = sv_state(1000, 90_000_000, 10_000_000)
  and {
    // post_total = (cont - min_utxo - reserve) + active_coverage
    //            = 180M + 90M = 270M; coverage * 3 = post_total.
    underwrite_ok(
      old,
      new,
      90_000_000,
      20_000_000,
      19_600_000,
      260_400_000 + min_utxo_lovelace,
      190_000_000 + min_utxo_lovelace,
      1,
      90_000_000,
      min_utxo_lovelace,
    ),
    !underwrite_ok_with_utilisation(
      old,
      new,
      90_000_000,
      20_000_000,
      19_600_000,
      260_400_000 + min_utxo_lovelace,
      190_000_000 + min_utxo_lovelace,
      1,
      90_000_000,
      min_utxo_lovelace,
      3_333,
    ),
    underwrite_ok_with_utilisation(
      old,
      new,
      90_000_000,
      20_000_000,
      19_600_000,
      260_400_000 + min_utxo_lovelace,
      190_000_000 + min_utxo_lovelace,
      1,
      90_000_000,
      min_utxo_lovelace,
      3_334,
    ),
  }
}

/// Validator-level proof that the exact one-third transaction is rejected by
/// the genesis registry's 3333-bps setting after the candidate is wired in.
test sv_underwrite_governed_parameter_3333_refuses_exact_one_third_boundary() {
  let old = sv_state(1000, 0, 10_000_000)
  let new = sv_state(1000, 90_000_000, 10_000_000)
  let pd =
    PolicyDatum { ..sv_underwrite_policy_datum(), coverage_amount: 90_000_000 }
  let tx = sv_underwrite_tx(
    260_400_000 + min_utxo_lovelace,
    old,
    190_400_000 + min_utxo_lovelace,
    new,
    90_000_000,
    pd,
    100_000_000,
    100_000_000,
    sv_underwrite_terms(90_000_000),
    1,
  )
  let cfg = sv_config([sv_mandate(sv_ada_nft())])
  let b = cfg.budgets
  and {
    // Genesis (3333 bps) refuses at the exact-third boundary.
    !sv_run_underwrite(old, 90_000_000, 20_000_000, tx),
    // At 3334 bps, this same transaction must be admissible, isolating the cap.
    sv_run_underwrite(
      old,
      90_000_000,
      20_000_000,
      sv_with_registry_cfg(
        tx,
        UnderwriteConfig {
          ..cfg,
          budgets: Budgets { ..b, utilisation_bps: 3_334 },
        },
      ),
    ),
  }
}


/// A configured ratio above the historic 50x constant must actually widen the
/// production envelope, within Registry's 200x rail. Coverage / NET premium is
/// 1.5B / 19.6M ~= 76.53x: legacy/default 50x refuses; governed 100x admits.
test sv_underwrite_governed_parameter_ratio_100_allows_above_legacy_50x() {
  let old = sv_state(1000, 0, 10_000_000)
  let new = sv_state(1000, 1_500_000_000, 10_000_000)
  let pd =
    PolicyDatum {
      ..sv_underwrite_policy_datum(),
      coverage_amount: 1_500_000_000,
    }
  let tx = sv_underwrite_tx(
    6_000_000_000,
    old,
    4_520_000_000,
    new,
    1_500_000_000,
    pd,
    100_000_000,
    100_000_000,
    sv_underwrite_terms(1_500_000_000),
    1,
  )
  let cfg = sv_config([sv_mandate(sv_ada_nft())])
  let b = cfg.budgets
  and {
    !sv_run_underwrite(old, 1_500_000_000, 20_000_000, tx),
    sv_run_underwrite(
      old,
      1_500_000_000,
      20_000_000,
      sv_with_registry_cfg(
        tx,
        UnderwriteConfig {
          ..cfg,
          budgets: Budgets { ..b, max_coverage_ratio: 100 },
        },
      ),
    ),
  }
}
