# Browser-visible configuration is public. Never put credentials in VITE_*.
VITE_BLOCKFROST_PROXY_URL=

# Server-only Blockfrost proxy configuration (never expose to Vite/browser)
# BLOCKFROST_API_KEY=
# BLOCKFROST_PROXY_ALLOWED_ORIGINS=https://your-dapp.example
# BLOCKFROST_PROXY_PORT=3001

# Deployment-specific protocol identities
VITE_TREASURY_ADDRESS=
VITE_COUNTER_SCRIPT_ADDRESS=
VITE_TICKET_POLICY_ID=
VITE_RELAYER_PKH=
VITE_ORACLE_PUBLISHER_PKH=
VITE_ORACLE_STATE_POLICY_ID=
VITE_ORACLE_STATE_TOKEN_NAME_HEX=
VITE_ORACLE_STATE_ADDRESS=
VITE_B1_POOL_TOKEN_POLICY_ID=
VITE_B1_POOL_TOKEN_NAME_HEX=
VITE_V3_CARRIER_ADDRESS=
VITE_V3_CARRIER_POLICY_ID=
VITE_V3_CARRIER_TOKEN_NAME_HEX=
VITE_B2_CONTROL_ADDRESS=
VITE_B2_CONTROL_POLICY_ID=
VITE_B2_CONTROL_TOKEN_NAME_HEX=
VITE_PRIZE_VALIDATOR_REFERENCE_ADDRESS=
VITE_B1_PRIZE_POOL_REFERENCE_ADDRESS=

# First-user authoritative Issue boundary (public endpoint + deployment artifact only)
VITE_ISSUE_AUTHORITY_ENDPOINT=
VITE_V3_CARRIER_FACTORY_URL=

# Server-side Issue authority service (NEVER expose these in VITE_ variables)
# ISSUE_AUTHORITY_PORT=8787
# ISSUE_AUTHORITY_CORS_ORIGIN=https://your-dapp-origin.example
# ISSUE_AUTHORITY_SOURCE_URL=
# ISSUE_AUTHORITY_PUBLIC_KEY=
# ISSUE_ADMISSION_COMMAND=cabal
# ISSUE_ADMISSION_ARGS_JSON=["run","issue-admission","--","--json"]
# DIRECT_USDM_UNIT=
# B1_PRIZE_POOL_ADDRESS=
