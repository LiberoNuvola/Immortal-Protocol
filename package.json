{
  "dependencies": {
    "dotenv": "^17.0.0",
    "@lucid-evolution/lucid": "0.6.5",
    "lucid-cardano": "0.10.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "relayer": "node relayer/relayer.js",
