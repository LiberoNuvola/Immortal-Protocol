cabal-version:      3.0
name:               immortal-governance
version:            0.1.0.0
build-type:         Simple

library
    hs-source-dirs:
        .
    exposed-modules:
        Governance
        GovernanceAuthorization
        GovernanceCanonicalReplay
        GovernanceCanonicalSerialization
        GovernanceCanonicalizationWitness
        GovernanceCommitment
        GovernanceConformance
        GovernanceConformanceWitness
        GovernanceDecisionWitness
        GovernanceEventSchema
        GovernanceFinality
        GovernanceRuleset
        RulesetRegistry
    build-depends:
        base ^>=4.18.2,
        base16-bytestring,
        bytestring,
        cryptohash-sha256,
        text
    default-language: Haskell2010
    ghc-options: -Wall

test-suite governance-conformance-tests
    type: exitcode-stdio-1.0
    hs-source-dirs: .
    main-is: GovernanceConformanceTest.hs
    build-depends:
        base ^>=4.18.2,
        immortal-governance
    default-language: Haskell2010
    ghc-options: -Wall

test-suite governance-canonical-event-tests
    type: exitcode-stdio-1.0
    hs-source-dirs: .
    main-is: GovernanceCanonicalEventTest.hs
    build-depends:
        base ^>=4.18.2,
        base16-bytestring,
        bytestring,
        cryptohash-sha256,
        text,
        immortal-governance
    default-language: Haskell2010
    ghc-options: -Wall

test-suite governance-canonical-replay-tests
    type: exitcode-stdio-1.0
    hs-source-dirs: .
    main-is: GovernanceCanonicalReplayTest.hs
    build-depends:
