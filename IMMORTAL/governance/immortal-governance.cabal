    default-language: Haskell2010
    ghc-options: -Wall

test-suite governance-ruleset-tests
    type: exitcode-stdio-1.0
    hs-source-dirs: .
    main-is: RulesetRegistryTest.hs
    build-depends:
        base ^>=4.18.2,
        immortal-governance
    default-language: Haskell2010
    ghc-options: -Wall

test-suite governance-phase6-tests
    type: exitcode-stdio-1.0
